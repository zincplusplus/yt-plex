# Optional docker-compose overrides — only needed if running WITHOUT CasaOS
# and you want non-default values. Without this file the app works with defaults.
# Copy to .env and uncomment what you need.

# Where downloaded videos are stored (default: ./downloads)
# DOWNLOADS_DIR=/mnt/nas/YouTube

# Host port (default: 8081)
# PORT=8081

# Auth keys — leave blank for anonymous local mode
# YT_PLEX_ADMIN_KEY=your-key-here
# YT_PLEX_OPERATOR_KEY=your-key-here

# Note: Gemini API key is set in the app's Settings panel (not here).
