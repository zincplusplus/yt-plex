DOWNLOADS_DIR=./downloads
SCAN_INTERVAL=360
SLEEP_BETWEEN_DOWNLOADS=5
SPONSORBLOCK=true
PREFERRED_RESOLUTION=1080p
OUTPUT_TEMPLATE=%(channel)s/%(title)s [%(id)s].%(ext)s
RETENTION_DAYS=14

# Gemini AI fallback for SponsorBlock (optional)
# When SponsorBlock has no data, analyzes subtitles with Gemini to find sponsors
# GEMINI_API_KEY=your-api-key-here
